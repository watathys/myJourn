MYJOURN_DATABASE_URL=sqlite:///./myjourn.db
MYJOURN_OPENAI_API_KEY=
MYJOURN_OPENAI_MODEL=gpt-5.5

# Google Calendar integration (for phone-notification reminders). Leave blank to
# disable "Connect Google Calendar" in the UI.
MYJOURN_GOOGLE_CLIENT_ID=
MYJOURN_GOOGLE_CLIENT_SECRET=
MYJOURN_GOOGLE_REDIRECT_URI=https://genfm.app/api/auth/google/callback
MYJOURN_GOOGLE_POST_AUTH_REDIRECT=https://genfm.app/
MYJOURN_GOOGLE_CALENDAR_ID=primary
